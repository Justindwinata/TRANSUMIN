# TRANSUM-IN Backend Environment Configuration

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/transumin"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000"

# API Configuration
API_VERSION=1

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (optional - for caching)
# REDIS_URL="redis://localhost:6379"

# External APIs
# GTFS_DATA_URL="https://example.com/gtfs-data.zip"
