datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?        @map("password_hash")
  fullName      String         @map("full_name")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  identities    AuthIdentity[]
  savedPlaces   SavedPlace[]
  savedJourneys SavedJourney[]
  journeyHistory JourneyHistory[]
  notifications Notification[]

  @@map("users")
}

model AuthIdentity {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  provider     String   // email, google, facebook
  providerId   String?  @map("provider_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("auth_identities")
}

// Transit Data Foundation
model DataSource {
  id              String   @id @default(uuid())
  name            String
  url             String
  license         String?
  lastFetchedAt   DateTime @map("last_fetched_at")
  checksum        String?  @map("checksum")
  retrievedAt     DateTime @map("retrieved_at")
  validatedAt     DateTime @map("validated_at")
  effectiveFrom   DateTime? @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  sourceType      String   @default("gtfs") @map("source_type")
  sourceStatus    String   @default("active") @map("source_status")
  licenseUrl      String?  @map("license_url")
  datasets        DatasetVersion[]

  @@map("data_sources")
}

model DatasetVersion {
  id              String   @id @default(uuid())
  sourceId        String   @map("source_id")
  version         String
  isActive        Boolean  @default(false) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  retrievedAt     DateTime @map("retrieved_at")
  validatedAt     DateTime @map("validated_at")
  checksum        String?  @map("checksum")
  effectiveFrom   DateTime? @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  status          String   @default("downloaded")
  validationResult String?  @map("validation_result")
  agenciesCount   Int      @default(0) @map("agencies_count")
  routesCount     Int      @default(0) @map("routes_count")
  stopsCount      Int      @default(0) @map("stops_count")
  tripsCount      Int      @default(0) @map("trips_count")
  stopTimesCount  Int      @default(0) @map("stop_times_count")
  calendarsCount  Int      @default(0) @map("calendars_count")
  transfersCount  Int      @default(0) @map("transfers_count")
  source          DataSource @relation(fields: [sourceId], references: [id])

  @@map("dataset_versions")
}

model Agency {
  id              String   @id @default(uuid())
  name            String
  shortName       String   @map("short_name")
  authority       String
  website         String?
  sourceUrl       String?  @map("source_url")
  lastVerifiedAt  DateTime @default(now()) @map("last_verified_at")
  routes          Route[]
  stops           Stop[]

  @@map("agencies")
}

model Route {
  id              String      @id @default(uuid())
  agencyId        String      @map("agency_id")
  shortName       String      @map("short_name")
  longName        String      @map("long_name")
  routeType       String      @map("route_type") 
  serviceType     String      @map("service_type")
  color           String?
  agency          Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  trips           Trip[]

  @@map("routes")
}

model Station {
  id              String   @id @default(uuid())
  name            String
  lat             Float
  lon             Float
  operator        String?
  stops           Stop[]

  @@map("stations")
}

model Stop {
  id              String     @id @default(uuid())
  agencyId        String     @map("agency_id")
  name            String
  lat             Float
  lon             Float
  stationId       String?    @map("station_id")
  station         Station?   @relation(fields: [stationId], references: [id])
  agency          Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  stopTimes       StopTime[]

  @@map("stops")
}

model Trip {
  id              String     @id @default(uuid())
  routeId         String     @map("route_id")
  serviceId       String     @map("service_id")
  directionId     Int        @map("direction_id")
  headsign        String
  route           Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopTimes       StopTime[]

  @@map("trips")
}

model StopTime {
  tripId          String   @map("trip_id")
  stopId          String   @map("stop_id")
  arrivalTime     String   @map("arrival_time")
  departureTime   String   @map("departure_time")
  stopSequence    Int      @map("stop_sequence")
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop            Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@id([tripId, stopSequence])
  @@map("stop_times")
}

model ServiceCalendar {
  serviceId       String   @id @map("service_id")
  monday          Boolean
  tuesday         Boolean
  wednesday       Boolean
  thursday        Boolean
  friday          Boolean
  saturday        Boolean
  sunday          Boolean
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")

  @@map("service_calendars")
}

model Transfer {
  id              String   @id @default(uuid())
  fromStopId      String   @map("from_stop_id")
  toStopId        String   @map("to_stop_id")
  transferType    Int      @map("transfer_type")
  minTransferTime Int?     @map("min_transfer_time")

  @@map("transfers")
}

model SavedPlace {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  address     String
  lat         Float
  lon         Float
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("saved_places")
}

model SavedJourney {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  originName  String   @map("origin_name")
  destName    String   @map("dest_name")
  payloadJson String   @map("payload_json")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("saved_journeys")
}

model JourneyHistory {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  originName  String   @map("origin_name")
  destName    String   @map("dest_name")
  summaryJson String   @map("summary_json")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("journey_history")
}

model ServiceAlert {
  id              String   @id @default(uuid())
  title           String
  description     String
  startsAt        DateTime @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  severity        String
  status          String
  source          String   @default("fixture") @map("source")
  operatorName    String?  @map("operator_name")
  affectedRoute   String?  @map("affected_route")
  affectedStop    String?  @map("affected_stop")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("service_alerts")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  body        String
  type        String
  severity    String
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
